# dev.env.example — local development credentials template
#
# Usage: copy to dev.env (gitignored, never committed), fill in real values, then:
#     set -a; . ./dev.env; set +a
#     cd build_host && ./sample_things_model
#
# The samples read these via environment variables (see each sample's getenv); if unset they fall
# back to the placeholder defaults compiled into the source.
# Never commit real app_key / app_license / private addresses into the repository.

export THING_MODEL_BROKER=127.0.0.1
export THING_MODEL_APP_ID=YOUR_APP_ID
export THING_MODEL_APP_NAME=YOUR_APP_NAME
export THING_MODEL_APP_KEY=YOUR_APP_KEY
export THING_MODEL_APP_LICENSE=YOUR_APP_LICENSE
export THING_MODEL_DEVICE_SN=YOUR_DEVICE_SN
export THING_MODEL_DEVICE_NAME=psdk_test          # device name reported in device_info (unset = source macro SAMPLE_DEVICE_NAME)
export THING_MODEL_CA_CERT_PATH=/path/to/ca.crt
